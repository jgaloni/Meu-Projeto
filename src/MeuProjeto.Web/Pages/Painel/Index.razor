@page "/painel"
@using MeuProjeto.Aplicacao.Paineis
@using MeuProjeto.Web.Servicos.Paineis
@inject IPainelApiCliente PainelApiCliente

<h1 class="mb-4"><i class="bi bi-bar-chart-fill"></i> Painel</h1>

@if (_carregando)
{
    <p class="text-muted">Carregando painel...</p>
}
else if (_mensagemErro is not null)
{
    <div class="alert alert-danger">@_mensagemErro</div>
}
else if (_painel is not null)
{
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-journal-text fs-1 text-primary"></i>
                    <h2 class="mt-2 mb-0">@_painel.TotalAnotacoes</h2>
                    <p class="text-muted mb-0">Anotações</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-tags fs-1 text-success"></i>
                    <h2 class="mt-2 mb-0">@_painel.TotalCategorias</h2>
                    <p class="text-muted mb-0">Categorias</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-question-circle fs-1 text-secondary"></i>
                    <h2 class="mt-2 mb-0">@_painel.AnotacoesSemCategoria</h2>
                    <p class="text-muted mb-0">Sem categoria</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Anotações por categoria</h5>

            @if (_painel.AnotacoesPorCategoria.Count == 0)
            {
                <p class="text-muted mb-0">Nenhuma categoria cadastrada ainda.</p>
            }
            else
            {
                @foreach (var item in _painel.AnotacoesPorCategoria)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <span>@item.Nome</span>
                            <span class="text-muted">@item.Quantidade</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" style="width: @CalcularPorcentagem(item.Quantidade)%"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private PainelDto? _painel;
    private bool _carregando = true;
    private string? _mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _painel = await PainelApiCliente.ObterAsync();
        }
        catch (HttpRequestException)
        {
            _mensagemErro = "Não foi possível conectar à API.";
        }

        _carregando = false;
    }

    private int CalcularPorcentagem(int quantidade)
    {
        if (_painel is null || _painel.TotalAnotacoes == 0)
        {
            return 0;
        }

        return quantidade * 100 / _painel.TotalAnotacoes;
    }
}
